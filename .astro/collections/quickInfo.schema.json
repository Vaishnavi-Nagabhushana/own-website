{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number"
      },
      "icon": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "lucide"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "simple-icons"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ]
          }
        ]
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "icon",
      "text"
    ]
  }
}
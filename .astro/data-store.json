\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false},\"legacy\":{\"collections\":false},\"session\":{\"driver\":\"fs-lite\",\"options\":{\"base\":\"/home/vaishnavi/main/vaishnavi-webpage/node_modules/.astro/sessions\"}}}","other",["Map",11,12],"about",{"id":11,"data":13,"body":14,"filePath":15,"digest":16,"deferredRender":17},{},"Spectre is a terminal-inspired theme for Astro!\r\n\r\nIt features a sleek dark-mode aesthetic, various social features inspired by Neocities, perfect lighthouse scores, full keyboard accessibility, comments powered by [giscus](https://giscus.app), a search powered by [pagefind](https://pagefind.app) and more!\r\n\r\nIf you want to dive deeper, check out the example project, and if you want to get started, check out the blog post!","src/content/other/about.mdx","08da4f9c3c40ed4d",true,"projects",["Map",20,21,35,36],"hi",{"id":20,"data":22,"body":32,"filePath":33,"digest":34,"deferredRender":17},{"title":23,"description":24,"date":25,"info":26},"Misc hi to check","Hi from hi.mdx",["Date","2025-08-25T00:00:00.000Z"],[27],{"text":28,"icon":29},"Paper library",{"type":30,"name":31},"lucide","book-open","import Card from '../../components/Card.astro';\n\n\u003CCard>\n  \u003Cdiv>\n    \u003Ch3>Hi, this is from hi.mdx\u003C/h3>\n    \u003Cp>It's just some dumb testing\u003C/p>\n  \u003C/div>\n\u003C/Card>","src/content/projects/hi.mdx","db1a21e9c096d9df","misc-papers",{"id":35,"data":37,"body":44,"filePath":45,"digest":46,"deferredRender":17},{"title":38,"description":39,"date":40,"info":41},"Misc Papers","Curated shortlist of continual-learning & AI papers — bite-sized takeaways.",["Date","2025-08-15T00:00:00.000Z"],[42],{"text":28,"icon":43},{"type":30,"name":31},"import Card from '../../components/Card.astro';\n\n\u003CCard>\n\n### Elastic Weight Consolidation  \n\u003Csmall>[arXiv:1612.00796](https://arxiv.org/abs/1612.00796)\u003C/small>\n\nSelectively slows learning on parameters critical to earlier tasks, reducing catastrophic forgetting via a quadratic regulariser.\n\n---\n\n### iCaRL – Incremental Classifier and Representation Learning  \n\u003Csmall>[arXiv:1611.07725](https://arxiv.org/abs/1611.07725)\u003C/small>\n\nLearns new classes incrementally with exemplar rehearsal + nearest-mean classifier; no catastrophic forgetting.\n\n---\n\n### Learning without Forgetting  \n\u003Csmall>[arXiv:1606.09282](https://arxiv.org/abs/1606.09282)\u003C/small>\n\nUses knowledge distillation to preserve performance on old tasks while training on new tasks — no access to old data.\n\n\u003C/Card>","src/content/projects/misc-papers.mdx","3b2829d617b68674","posts",["Map",20,49],{"id":20,"data":50,"body":61,"filePath":62,"digest":63,"deferredRender":17},{"title":51,"createdAt":52,"description":53,"tags":54,"draft":60},"Misc blog",["Date","2025-08-25T00:00:00.000Z"],"Hi from blog.mdx",[55,58],{"id":56,"collection":57},"test","tags",{"id":59,"collection":57},"blog",false,"import Card from '../../components/Card.astro';\n\n\u003CCard>\n\n### Hi this is from hi.mdxA\n\n---\n\u003Cp> its just some dumb testing\u003C/p>\n\u003C/Card>","src/content/posts/hi.mdx","88cf42f77482fa04",["Map",65,66],"guide",{"id":65,"data":67,"filePath":68},{"id":65},"src/content/tags.json","quickInfo",["Map",71,72,79,80],"1",{"id":71,"data":73,"filePath":78},{"id":74,"icon":75,"text":77},1,{"type":30,"name":76},"cake","1 year old","src/content/info.json","2",{"id":79,"data":81,"filePath":78},{"id":82,"icon":83,"text":85},2,{"type":30,"name":84},"earth","Made in Germany","socials",["Map",71,88],{"id":71,"data":89,"filePath":94},{"id":74,"icon":90,"text":92,"link":93},{"type":30,"name":91},"github","GitHub","https://github.com/louisescher/spectre","src/content/socials.json","workExperience",["Map",71,97],{"id":71,"data":98,"filePath":103},{"id":74,"title":99,"company":100,"duration":101,"d